{
  "manifest_version": 3,
  "name": "Pointy",
  "version": "1.0.1",
  "description": "Draw on your site and talk. It compiles into a brief a coding agent can execute.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*.localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
    "http://*.localhost/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
    "http://*.localhost/*"
      ],
      "js": ["app.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Pointy — draw + talk",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P" },
      "description": "Toggle the Pointy overlay"
    }
  }
}
